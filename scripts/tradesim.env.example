# Template only: no real values. Copy to ~/.tradesim.env on the EC2 host and chmod 600 (see README).
# scripts/lib.sh sources that file; variables set here are visible to every script.
KUBECTL="sudo k3s kubectl"
GHCR_OWNER=pdt-faisaldemo
GITHUB_REPO_URL=https://github.com/pdt-faisaldemo/tradesim

# Alerts (alert-bridge) and fallback for change events: Global Event Orchestration routing key
PD_ROUTING_KEY=
# Per-service Change Events integration keys
PD_CHANGE_KEY_GATEWAY=
PD_CHANGE_KEY_ORDER=
PD_CHANGE_KEY_RISK=
PD_CHANGE_KEY_ACCOUNT=
PD_CHANGE_KEY_PORTFOLIO=
PD_CHANGE_KEY_MARKET_DATA=
# reset.sh: resolve open incidents (REST API key, a PagerDuty user email, comma-separated service ids)
PD_API_TOKEN=
PD_FROM_EMAIL=
PD_SERVICE_IDS=
